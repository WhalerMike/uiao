{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://uiao.gov/schemas/orgpath-admin-units.schema.json",
  "title": "OrgTree Administrative Unit Registry (Model C)",
  "description": "Per-facet AU registry declaring canonical Entra Administrative Units with composed membership rules. Companion to ADR-037 (admin unit provisioning) and ADR-084 (per-facet consumer architecture).",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "registry_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "generated_date": {
      "type": "string",
      "format": "date-time"
    },
    "units": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/AdminUnit" }
    }
  },
  "required": ["schema_version", "registry_version", "units"],
  "additionalProperties": false,
  "$defs": {
    "AdminUnit": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^AU-[A-Za-z0-9-]+$"
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "restricted_management": {
          "type": "boolean",
          "default": true
        },
        "composition": { "$ref": "#/$defs/CompositionSpec" },
        "scoped_roles": {
          "type": "array",
          "items": { "$ref": "#/$defs/ScopedRole" }
        }
      },
      "required": ["name", "description", "composition"],
      "additionalProperties": false
    },
    "ScopedRole": {
      "type": "object",
      "properties": {
        "role": { "type": "string", "minLength": 1 },
        "delegate": { "type": "string", "minLength": 1 }
      },
      "required": ["role", "delegate"],
      "additionalProperties": false
    },
    "CompositionSpec": {
      "type": "object",
      "properties": {
        "combinator": { "enum": ["and", "or"], "default": "and" },
        "predicates": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/FacetPredicate" }
        }
      },
      "required": ["predicates"],
      "additionalProperties": false
    },
    "FacetPredicate": {
      "type": "object",
      "properties": {
        "facet": { "type": "string" },
        "op": {
          "enum": ["-eq", "-ne", "-ge", "-le", "-gt", "-lt", "-startsWith", "-contains", "-match", "-in", "-notIn"]
        },
        "value": {
          "oneOf": [
            { "type": "string" },
            { "type": "array", "items": { "type": "string" } }
          ]
        }
      },
      "required": ["facet", "op", "value"],
      "additionalProperties": false
    }
  }
}
