{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://uiao.gov/schemas/orgpath-dynamic-groups.schema.json",
  "title": "OrgTree Dynamic Group Library (Model C)",
  "description": "Per-facet dynamic group library declaring canonical Entra dynamic groups composed from CompositionSpec facet predicates. Companion to ADR-036 (dynamic group provisioning) and ADR-084 (per-facet consumer architecture).",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "library_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "generated_date": {
      "type": "string",
      "format": "date-time"
    },
    "groups": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/DynamicGroup" }
    }
  },
  "required": ["schema_version", "library_version", "groups"],
  "additionalProperties": false,
  "$defs": {
    "DynamicGroup": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^OrgTree-[A-Za-z0-9-]+$",
          "description": "Display name; must start with OrgTree- prefix."
        },
        "category": {
          "type": "string",
          "enum": ["Region", "Department", "Division", "Role", "CostCenter", "Classification", "Clearance", "AccountType", "Lifecycle", "Cross-Cutting", "CA", "Licensing"]
        },
        "group_type": {
          "type": "string",
          "enum": ["Security", "M365"],
          "default": "Security"
        },
        "composition": { "$ref": "#/$defs/CompositionSpec" },
        "description": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": ["name", "category", "composition", "description"],
      "additionalProperties": false
    },
    "CompositionSpec": {
      "type": "object",
      "properties": {
        "combinator": {
          "type": "string",
          "enum": ["and", "or"],
          "default": "and"
        },
        "predicates": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/FacetPredicate" }
        }
      },
      "required": ["predicates"],
      "additionalProperties": false
    },
    "FacetPredicate": {
      "type": "object",
      "properties": {
        "facet": { "type": "string" },
        "op": {
          "type": "string",
          "enum": ["-eq", "-ne", "-ge", "-le", "-gt", "-lt", "-startsWith", "-contains", "-match", "-in", "-notIn"]
        },
        "value": {
          "oneOf": [
            { "type": "string" },
            { "type": "array", "items": { "type": "string" } }
          ]
        }
      },
      "required": ["facet", "op", "value"],
      "additionalProperties": false
    }
  }
}
