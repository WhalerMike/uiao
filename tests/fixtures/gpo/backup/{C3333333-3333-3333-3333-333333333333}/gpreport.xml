<?xml version="1.0" encoding="utf-8"?>
<GPO xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://www.microsoft.com/GroupPolicy/Settings">
  <Identifier>
    <Identifier xmlns="http://www.microsoft.com/GroupPolicy/Types">{C3333333-3333-3333-3333-333333333333}</Identifier>
    <Domain xmlns="http://www.microsoft.com/GroupPolicy/Types">corp.contoso.com</Domain>
  </Identifier>
  <Name>User Drive Maps and Logon Scripts</Name>
  <CreatedTime>2017-07-19T08:00:00</CreatedTime>
  <ModifiedTime>2022-11-03T11:15:00</ModifiedTime>
  <FilterName>Workstations Only (WMI)</FilterName>
  <Computer>
    <Enabled>false</Enabled>
  </Computer>
  <User>
    <Enabled>true</Enabled>
    <ExtensionData>
      <Extension xmlns:q3="http://www.microsoft.com/GroupPolicy/Settings/Scripts" xsi:type="q3:Scripts">
        <q3:Script>
          <q3:Command>\\corp.contoso.com\netlogon\mapdrives.bat</q3:Command>
          <q3:Type>Logon</q3:Type>
        </q3:Script>
      </Extension>
      <Extension xmlns:q4="http://www.microsoft.com/GroupPolicy/Settings/Preferences/Drives" xsi:type="q4:DriveMapSettings">
        <q4:Drive name="H: (Home)">
          <q4:Properties action="U" letter="H" path="\\fs01\home\%username%" />
        </q4:Drive>
        <q4:Drive name="S: (Shared)">
          <q4:Properties action="U" letter="S" path="\\fs01\shared" />
        </q4:Drive>
      </Extension>
    </ExtensionData>
  </User>
  <LinksTo>
    <SOMName>Engineering</SOMName>
    <SOMPath>corp.contoso.com/Engineering</SOMPath>
    <Enabled>true</Enabled>
    <NoOverride>false</NoOverride>
  </LinksTo>
  <LinksTo>
    <SOMName>Sales</SOMName>
    <SOMPath>corp.contoso.com/Sales</SOMPath>
    <Enabled>false</Enabled>
    <NoOverride>false</NoOverride>
  </LinksTo>
</GPO>
