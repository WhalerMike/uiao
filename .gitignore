# Python build artifacts
__pycache__/
*.pyc
*.pyo
*.pyd
*.egg-info/
src/uiao.egg-info/
build/
dist/
*.whl
# Allow intentionally-committed offline wheels in deps/
!deps/*.whl
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Virtual environments
.venv/
venv/
env/

# Generated artifacts (written by uiao generate-* commands)
exports/

# Image pipeline manifest — deterministic aggregation rebuilt on every
# `python scripts/generate_images.py` run. Not source; rebuild with
# `--scan-only` whenever needed.
docs/images/.image-manifest.json

# Corpus index — generated by docs/scripts/update_corpus_index.js and
# regenerated by the Update Corpus Index workflow (in the docs subrepo)
# on push to main. Path is relative to monorepo root; in the docs subrepo
# the same artifact lives at docs/_data/corpus-index.json.
docs/docs/_data/corpus-index.json

# IDE / editor
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# Quarto
_site/
_freeze/
.quarto/

# OS / misc
*.log
*.tmp
.claude/

# Windows shell mishap — `git lfs install` (or similar) invoked with
# `/dev/null` as a path on Windows creates this directory in the worktree
# instead of redirecting to the null device. The real LFS hooks live in
# .git/hooks/ per core.hookspath.
dev/null/

# Audit input scratch — source files copied from OneDrive for agent review.
# Not for commit; archive/delete when audit complete.
/inbox/_audit-input/

/.quarto/
**/*.quarto_ipynb

doc-audit*.csv

# Local analysis output (regenerated by repo scripts; not source)
/png_files.csv
/qmd-files.csv
/qmd-files.txt
/qmd-image-inventory.csv
/qmd-diagram-recommendations.md
/qmd-diagram-recommendations.tsv
/qmd-diagram-shortlist.csv
/out/lychee-report/

# Personal / opaque artifacts swept in from local clipboard or messaging app drops
*.crypt14
HY8aoUCJGfX6jmanoWYDo.bin

# Personal / opaque artifacts swept in from local clipboard or messaging app drops
*.crypt14
HY8aoUCJGfX6jmanoWYDo.bin

# Lychee local-run diagnostic artifacts (created by manual ad-hoc runs)
/lychee-inbox-report.md
/lychee-inbox-stdout.txt

# Local .docx deliverables (binary build output — not source)
out/saas-docx/
examples/orgtree/golden-path/out/

# Session scratch dirs (root and inbox variants) — never repo content
.scratch/

# Pre-rename federal-aan-series local renders (superseded by
# orgcomp-series; 0 tracked files remain — the dir is old build output
# only, and unignored it is one bulk `git add` away from re-entering
# history right after the 2026-07-20 rewrite)
docs/customer-documents/federal-aan-series/

