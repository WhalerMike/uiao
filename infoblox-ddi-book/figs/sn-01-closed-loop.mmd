graph LR
  REQ["Service Catalog request<br/>(subnet / DNS record / DDI deploy)"]:::ctrl
  APP["Flow Designer<br/>approval + SoD gate"]:::ctrl
  TF["CPG Terraform Connector<br/>plan → approve → apply"]:::ctrl
  IBX["Infoblox IPAM/DNS<br/>allocate + register (WAPI/UDDI)"]:::ibx
  VAL["MID Server gate<br/>dns / discovery / conflict checks"]:::native
  CMDB["ServiceNow CMDB<br/>Service Graph Connector sync"]:::spoke
  REQ --> APP --> TF --> IBX --> VAL --> CMDB --> DONE["Close request<br/>audit trail"]:::ctrl
  VAL -. "fail" .-> APP
  classDef ibx fill:#C00000,stroke:#7d0000,color:#fff;
  classDef native fill:#548235,stroke:#38571f,color:#fff;
  classDef spoke fill:#2E75B6,stroke:#1c4e7a,color:#fff;
  classDef ctrl fill:#7030A0,stroke:#4c2070,color:#fff;
  classDef ext fill:#595959,stroke:#333333,color:#fff;
