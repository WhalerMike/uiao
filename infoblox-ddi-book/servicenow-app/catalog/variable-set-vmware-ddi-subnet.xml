<?xml version="1.0" encoding="UTF-8"?>
<!--
  Catalog variable set — "Request a DDI-backed subnet" (VMware)
  Scope: x_infoblox_ddi
  ===========================================================================
  STARTER SKELETON, but MACHINE-CHECKED. Each <item_option_new> is a catalog
  variable; its <map_to> names the VMware Terraform module variable it feeds
  (../../vmware-lz-automation/terraform/variables.tf). `contract_check.py`
  asserts that every REQUIRED module variable (one with no default) is covered
  by a <map_to> here, or resolved on the MID Server (<resolved_by_mid>) — so
  the form and the module cannot silently drift.

  On import: set the ServiceNow variable `type` codes and reference qualifiers
  to your instance conventions (the numeric `type` values below are the common
  defaults: 6=Single Line Text, 5=Select Box, 21=List, 7=Reference, 20=Multi
  Line Text, 24=Checkbox). The vCenter/NSX connection endpoints, users, and
  passwords come from the MID Server credential alias and are NEVER typed into
  the catalog form — this is the whole point of the resolved_by_mid split.
-->
<record_update table="item_option_new">
  <sys_variable_set action="INSERT_OR_UPDATE">
    <title>Request a DDI-backed subnet</title>
    <internal_name>x_infoblox_ddi_ddi_subnet_vmware</internal_name>
    <sys_scope>x_infoblox_ddi</sys_scope>
    <description>Front-door variable set; each variable maps to one VMware module tfvar (see map_to) or is resolved on the MID Server. The contract test keeps this ⊇ the module's required variables.</description>
  </sys_variable_set>

  <!-- ===== Required module variables (no default in variables.tf) ======= -->

  <item_option_new action="INSERT_OR_UPDATE">
    <name>target_platform</name><question_text>Target platform</question_text>
    <type>5</type><mandatory>true</mandatory>
    <map_to>__platform_selector__</map_to>
    <help_text>Selects the module + validation scripts; this variable set is the VMware instance.</help_text>
  </item_option_new>

  <item_option_new action="INSERT_OR_UPDATE">
    <name>vsphere_datacenter</name><question_text>vSphere datacenter</question_text>
    <type>7</type><mandatory>true</mandatory>
    <map_to>vsphere_datacenter</map_to>
    <help_text>Target vSphere datacenter; reference lookup, not free-typed.</help_text>
  </item_option_new>

  <item_option_new action="INSERT_OR_UPDATE">
    <name>compute_cluster</name><question_text>Compute cluster</question_text>
    <type>7</type><mandatory>true</mandatory>
    <map_to>compute_cluster</map_to>
    <help_text>Target compute cluster; reference lookup within the datacenter.</help_text>
  </item_option_new>

  <item_option_new action="INSERT_OR_UPDATE">
    <name>datastore</name><question_text>Datastore</question_text>
    <type>7</type><mandatory>true</mandatory>
    <map_to>datastore</map_to>
    <help_text>Target datastore; reference lookup of approved datastores.</help_text>
  </item_option_new>

  <item_option_new action="INSERT_OR_UPDATE">
    <name>management_portgroup</name><question_text>Management port group</question_text>
    <type>7</type><mandatory>true</mandatory>
    <map_to>management_portgroup</map_to>
    <help_text>Management port group; reference lookup, not free-typed.</help_text>
  </item_option_new>

  <item_option_new action="INSERT_OR_UPDATE">
    <name>ddi_mgmt_network_cidr</name><question_text>Requested CIDR</question_text>
    <type>6</type><mandatory>true</mandatory>
    <map_to>ddi_mgmt_network_cidr</map_to>
    <help_text>Must fit the management network, no overlap. Pre-flight + gate conflict-check it.</help_text>
  </item_option_new>

  <item_option_new action="INSERT_OR_UPDATE">
    <name>vnios_appliance_model</name><question_text>Appliance model</question_text>
    <type>5</type><mandatory>true</mandatory>
    <map_to>vnios_appliance_model</map_to>
    <help_text>NIOS-version dependent; pick-list of approved appliance models.</help_text>
  </item_option_new>

  <item_option_new action="INSERT_OR_UPDATE">
    <name>vnios_ovf</name><question_text>Appliance image (OVF)</question_text>
    <type>5</type><mandatory>true</mandatory>
    <map_to>vnios_ovf</map_to>
    <help_text>vNIOS OVF/OVA template; pick-list, do not hard-code a version.</help_text>
  </item_option_new>

  <item_option_new action="INSERT_OR_UPDATE">
    <name>mgmt_source_cidrs</name><question_text>Management source CIDRs</question_text>
    <type>21</type><mandatory>true</mandatory>
    <map_to>mgmt_source_cidrs</map_to>
    <help_text>Non-empty, never 0.0.0.0/0 (form-validate).</help_text>
  </item_option_new>

  <item_option_new action="INSERT_OR_UPDATE">
    <name>dns_client_cidrs</name><question_text>DNS client CIDRs</question_text>
    <type>21</type><mandatory>true</mandatory>
    <map_to>dns_client_cidrs</map_to>
    <help_text>Spoke/on-prem ranges permitted to query DNS.</help_text>
  </item_option_new>

  <!-- ===== Commonly-set optional module variables ======================= -->

  <item_option_new action="INSERT_OR_UPDATE">
    <name>environment</name><question_text>Environment</question_text>
    <type>5</type><mandatory>true</mandatory>
    <map_to>environment</map_to>
    <help_text>dev|test|prod — drives tags/sizing and the approval tier.</help_text>
  </item_option_new>

  <item_option_new action="INSERT_OR_UPDATE">
    <name>deployment_model</name><question_text>Deployment model</question_text>
    <type>5</type><mandatory>true</mandatory>
    <map_to>deployment_model</map_to>
    <help_text>grid (in-boundary) | universal_ddi (SaaS, gated).</help_text>
  </item_option_new>

  <item_option_new action="INSERT_OR_UPDATE">
    <name>acknowledge_saas_boundary</name><question_text>Acknowledge SaaS boundary</question_text>
    <type>24</type><mandatory>false</mandatory>
    <map_to>acknowledge_saas_boundary</map_to>
    <help_text>Required true only for universal_ddi; drives an extra approval.</help_text>
  </item_option_new>

  <!-- ===== Flow-only fields (not module tfvars — no map_to) ============== -->

  <item_option_new action="INSERT_OR_UPDATE">
    <name>host_fqdn</name><question_text>Host FQDN</question_text>
    <type>6</type><mandatory>true</mandatory>
    <help_text>Registered as the A + PTR for the allocated host IP. Consumed by the Flow, not a module tfvar.</help_text>
  </item_option_new>

  <item_option_new action="INSERT_OR_UPDATE">
    <name>business_justification</name><question_text>Business justification</question_text>
    <type>20</type><mandatory>true</mandatory>
    <help_text>Read first by the approver. Flow/record field, not a module tfvar.</help_text>
  </item_option_new>

  <!-- credential/secret vars resolved on the in-boundary MID Server, NOT typed on the form -->
  <resolved_by_mid>vsphere_server</resolved_by_mid>
  <resolved_by_mid>vsphere_user</resolved_by_mid>
  <resolved_by_mid>vsphere_password</resolved_by_mid>
  <resolved_by_mid>nsx_manager</resolved_by_mid>
  <resolved_by_mid>nsx_user</resolved_by_mid>
  <resolved_by_mid>nsx_password</resolved_by_mid>
  <resolved_by_mid>admin_password</resolved_by_mid>
</record_update>
