<?xml version="1.0" encoding="UTF-8"?>
<!--
  Catalog variable set — "Request a DDI-backed subnet" (OCI)
  Scope: x_infoblox_ddi
  ===========================================================================
  STARTER SKELETON, but MACHINE-CHECKED. Each <item_option_new> is a catalog
  variable; its <map_to> names the OCI Terraform module variable it feeds
  (../../oci-lz-automation/terraform/variables.tf). `contract_check.py`
  asserts that every REQUIRED module variable (one with no default) is covered
  by a <map_to> here, or resolved on the MID Server (<resolved_by_mid>) — so
  the form and the module cannot silently drift.

  On import: set the ServiceNow variable `type` codes and reference qualifiers
  to your instance conventions (the numeric `type` values below are the common
  defaults: 6=Single Line Text, 5=Select Box, 21=List, 7=Reference, 20=Multi
  Line Text, 24=Checkbox). Stage-1-sourced OCIDs should become reference
  lookups so requesters cannot free-type identity/compartment/vault OCIDs.
-->
<record_update table="item_option_new">
  <sys_variable_set action="INSERT_OR_UPDATE">
    <title>Request a DDI-backed subnet</title>
    <internal_name>x_infoblox_ddi_ddi_subnet_oci</internal_name>
    <sys_scope>x_infoblox_ddi</sys_scope>
    <description>Front-door variable set; each variable maps to one OCI module tfvar (see map_to) or is resolved on the MID Server. The contract test keeps this ⊇ the module's required variables.</description>
  </sys_variable_set>

  <!-- ===== Required module variables (no default in variables.tf) ======= -->

  <item_option_new action="INSERT_OR_UPDATE">
    <name>target_platform</name><question_text>Target platform</question_text>
    <type>5</type><mandatory>true</mandatory>
    <map_to>__platform_selector__</map_to>
    <help_text>Selects the module + validation scripts; this variable set is the OCI instance.</help_text>
  </item_option_new>

  <item_option_new action="INSERT_OR_UPDATE">
    <name>region</name><question_text>Region</question_text>
    <type>5</type><mandatory>true</mandatory>
    <map_to>region</map_to>
    <help_text>Commercial OCI region. Pick-list of approved regions; no default.</help_text>
  </item_option_new>

  <item_option_new action="INSERT_OR_UPDATE">
    <name>tenancy_ocid</name><question_text>Tenancy</question_text>
    <type>7</type><mandatory>true</mandatory>
    <map_to>tenancy_ocid</map_to>
    <help_text>Stage-1 output; tenancy OCID. Pre-populated reference.</help_text>
  </item_option_new>

  <item_option_new action="INSERT_OR_UPDATE">
    <name>network_compartment_ocid</name><question_text>Network compartment</question_text>
    <type>7</type><mandatory>true</mandatory>
    <map_to>network_compartment_ocid</map_to>
    <help_text>Stage-1 output; network compartment OCID. Pre-populated reference.</help_text>
  </item_option_new>

  <item_option_new action="INSERT_OR_UPDATE">
    <name>hub_vcn_ocid</name><question_text>Hub network (VCN)</question_text>
    <type>7</type><mandatory>true</mandatory>
    <map_to>hub_vcn_ocid</map_to>
    <help_text>Stage-1 output; hub VCN OCID. Pre-populated reference.</help_text>
  </item_option_new>

  <item_option_new action="INSERT_OR_UPDATE">
    <name>vault_ocid</name><question_text>Vault (secret reference)</question_text>
    <type>7</type><mandatory>true</mandatory>
    <map_to>vault_ocid</map_to>
    <help_text>Existing Vault holding module secrets. A REFERENCE only — no secret is entered on the form.</help_text>
  </item_option_new>

  <item_option_new action="INSERT_OR_UPDATE">
    <name>ddi_subnet_cidr</name><question_text>Requested CIDR</question_text>
    <type>6</type><mandatory>true</mandatory>
    <map_to>ddi_subnet_cidr</map_to>
    <help_text>Must fit the hub VCN, no overlap. Pre-flight + gate conflict-check it.</help_text>
  </item_option_new>

  <item_option_new action="INSERT_OR_UPDATE">
    <name>availability_domains</name><question_text>Availability domains</question_text>
    <type>21</type><mandatory>true</mandatory>
    <map_to>availability_domains</map_to>
    <help_text>ADs to spread the subnet across; region-dependent pick-list.</help_text>
  </item_option_new>

  <item_option_new action="INSERT_OR_UPDATE">
    <name>vnios_shape</name><question_text>Shape</question_text>
    <type>5</type><mandatory>true</mandatory>
    <map_to>vnios_shape</map_to>
    <help_text>Region/NIOS-version dependent; pick-list of approved shapes.</help_text>
  </item_option_new>

  <item_option_new action="INSERT_OR_UPDATE">
    <name>mgmt_source_cidrs</name><question_text>Management source CIDRs</question_text>
    <type>21</type><mandatory>true</mandatory>
    <map_to>mgmt_source_cidrs</map_to>
    <help_text>Non-empty, never 0.0.0.0/0 (form-validate).</help_text>
  </item_option_new>

  <item_option_new action="INSERT_OR_UPDATE">
    <name>dns_client_cidrs</name><question_text>DNS client CIDRs</question_text>
    <type>21</type><mandatory>true</mandatory>
    <map_to>dns_client_cidrs</map_to>
    <help_text>Spoke/on-prem ranges permitted to query DNS.</help_text>
  </item_option_new>

  <!-- ===== Commonly-set optional module variables ======================= -->

  <item_option_new action="INSERT_OR_UPDATE">
    <name>environment</name><question_text>Environment</question_text>
    <type>5</type><mandatory>true</mandatory>
    <map_to>environment</map_to>
    <help_text>dev|test|prod — drives tags/sizing and the approval tier.</help_text>
  </item_option_new>

  <item_option_new action="INSERT_OR_UPDATE">
    <name>deployment_model</name><question_text>Deployment model</question_text>
    <type>5</type><mandatory>true</mandatory>
    <map_to>deployment_model</map_to>
    <help_text>grid (in-boundary) | universal_ddi (SaaS, gated).</help_text>
  </item_option_new>

  <item_option_new action="INSERT_OR_UPDATE">
    <name>acknowledge_saas_boundary</name><question_text>Acknowledge SaaS boundary</question_text>
    <type>24</type><mandatory>false</mandatory>
    <map_to>acknowledge_saas_boundary</map_to>
    <help_text>Required true only for universal_ddi; drives an extra approval.</help_text>
  </item_option_new>

  <!-- ===== Flow-only fields (not module tfvars — no map_to) ============== -->

  <item_option_new action="INSERT_OR_UPDATE">
    <name>host_fqdn</name><question_text>Host FQDN</question_text>
    <type>6</type><mandatory>true</mandatory>
    <help_text>Registered as the A + PTR for the allocated host IP. Consumed by the Flow, not a module tfvar.</help_text>
  </item_option_new>

  <item_option_new action="INSERT_OR_UPDATE">
    <name>business_justification</name><question_text>Business justification</question_text>
    <type>20</type><mandatory>true</mandatory>
    <help_text>Read first by the approver. Flow/record field, not a module tfvar.</help_text>
  </item_option_new>

  <!-- credential/secret vars resolved on the in-boundary MID Server, NOT typed on the form -->
  <resolved_by_mid>admin_password_secret_ocid</resolved_by_mid>
  <resolved_by_mid>temp_license_secret_ocid</resolved_by_mid>
</record_update>
