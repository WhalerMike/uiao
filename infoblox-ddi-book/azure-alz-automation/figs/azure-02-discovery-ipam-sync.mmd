%% Azure discovery → Infoblox IPAM sync flow.
%% Palette per ../../figs/HOUSE-STYLE.md.
graph LR
  MI["Managed identity /<br/>Entra app reg<br/>Reader"]
  subgraph Azure["Azure subscriptions"]
    VNET["VNets / subnets / NICs"]
    TAGS["Resource tags"]
  end
  DISCO["Discovery job<br/>vDiscovery / Universal Cloud"]
  subgraph IB["Infoblox"]
    NET["IPAM networks<br/>+ containers"]
    EA["Extensible attributes<br/>(tags → EAs)"]
  end

  MI -- "read-only auth" --> DISCO
  DISCO -- "enumerate" --> VNET
  DISCO -- "enumerate" --> TAGS
  VNET -- "sync" --> NET
  TAGS -- "map" --> EA

  classDef ibx    fill:#C00000,stroke:#7d0000,color:#fff;
  classDef native fill:#548235,stroke:#38571f,color:#fff;
  classDef spoke  fill:#2E75B6,stroke:#1c4e7a,color:#fff;
  classDef ctrl   fill:#7030A0,stroke:#4c2070,color:#fff;
  classDef ext    fill:#595959,stroke:#333333,color:#fff;

  class MI,DISCO ctrl;
  class VNET,TAGS native;
  class NET,EA ibx;
