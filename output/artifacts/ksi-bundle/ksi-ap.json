    "terms-and-conditions": {
      "parts": [
        {
          "name": "assessment-basis",
          "title": "Assessment Methodology",
          "prose": "This assessment uses mapping-confidence-based verdicts derived from the UIAO AAN Conformance Adapter (ADR-061). Evidence is sourced from 6 AAN conformance adapter surface slots (Parts 1\u201314). A 'satisfied' verdict requires mapping confidence 'high' AND a high-confidence AAN slot evidence binding for the CR26 control(s). Scaffold rules (Status: scaffold) are assessed identically; the finding remark records the pending evaluation-engine state (ADR-111)."
        }
      ]
    },
