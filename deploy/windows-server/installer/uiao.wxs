<?xml version="1.0" encoding="UTF-8"?>
<!--
  deploy/windows-server/installer/uiao.wxs
  WiX v4 source for the UIAO governance API MSI installer.

  Build:
    dotnet tool install -global wix
    wix build uiao.wxs -o uiao-setup.msi

  Silent install (GPO/SCCM):
    msiexec /i uiao-setup.msi /quiet /l*v install.log ^
            TENANT_ID="<guid>" CLIENT_ID="<guid>" ^
            CLIENT_SECRET="<secret>" SERVICE_PORT="8001"

  After install:
    - UIAO Python package installed to C:\srv\uiao\.venv
    - UIAOService registered and set to auto-start
    - IIS site UIAO-API created with service-mode reverse-proxy web.config
    - Machine-level env vars set for UIAO_ENTRA_* credentials
-->

<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">

  <Package
    Name="UIAO Governance API"
    Manufacturer="WhalerMike"
    Version="!(bind.FileVersion.PythonExe)"
    UpgradeCode="B4E9F3A2-7C1D-4E8B-9F2A-3D6C0E5A1B7F"
    Scope="perMachine"
    Description="UIAO organizational governance API — OrgPath, AD assessment, and drift reporting.">

    <!-- Upgrade: remove old version before installing new -->
    <MajorUpgrade DowngradeErrorMessage="A newer version of UIAO is already installed." />

    <!-- ---------------------------------------------------------------
         Public properties — overridable on msiexec command line
         --------------------------------------------------------------- -->
    <Property Id="TENANT_ID"      Value="" Secure="yes" />
    <Property Id="CLIENT_ID"      Value="" Secure="yes" />
    <Property Id="CLIENT_SECRET"  Value="" Secure="yes" Hidden="yes" />
    <Property Id="SERVICE_PORT"   Value="8001" />
    <Property Id="INSTALL_DIR"    Value="C:\srv\uiao" />
    <Property Id="IIS_SITE_PATH"  Value="C:\inetpub\uiao-api" />
    <Property Id="LOG_PATH"       Value="C:\Logs\uiao-api" />
    <Property Id="PYTHON_VERSION" Value="3.13.0" />

    <!-- Require Windows Server 2022+ (build 20348) -->
    <Launch
      Condition="VersionNT64 &gt;= 603"
      Message="UIAO requires Windows Server 2022 or later (64-bit)." />

    <!-- ---------------------------------------------------------------
         Feature tree
         --------------------------------------------------------------- -->
    <Feature Id="ProductFeature" Title="UIAO Governance API" Level="1">
      <ComponentGroupRef Id="UIAOFiles" />
      <ComponentGroupRef Id="UIAOEnvVars" />
      <ComponentGroupRef Id="UIAOService" />
      <ComponentGroupRef Id="UIAOIISConfig" />
    </Feature>

    <!-- ---------------------------------------------------------------
         UI: minimal dialog set — collects TENANT_ID, CLIENT_ID, SECRET
         (WiX UI extension provides WixUI_Minimal as base)
         --------------------------------------------------------------- -->
    <ui:WixUI Id="WixUI_UIAO" />

    <!-- ---------------------------------------------------------------
         Custom actions — PowerShell bootstrapper
         --------------------------------------------------------------- -->

    <!-- CA: Run Install-UIAOServer.ps1 (IIS features + Python) -->
    <CustomAction
      Id="InstallDeps"
      Directory="INSTALLDIR"
      ExeCommand="powershell.exe -NonInteractive -ExecutionPolicy Bypass -File &quot;[INSTALLDIR]deploy\windows-server\Install-UIAOServer.ps1&quot;"
      Execute="deferred"
      Return="check"
      Impersonate="no" />

    <!-- CA: pip install uiao[api,service] -->
    <CustomAction
      Id="PipInstall"
      Directory="INSTALLDIR"
      ExeCommand="&quot;[INSTALLDIR].venv\Scripts\python.exe&quot; -m pip install --quiet &quot;[INSTALLDIR][api,service]&quot;"
      Execute="deferred"
      Return="check"
      Impersonate="no" />

    <!-- CA: Install-UIAOService.ps1 (register + start Windows Service) -->
    <CustomAction
      Id="InstallService"
      Directory="INSTALLDIR"
      ExeCommand="powershell.exe -NonInteractive -ExecutionPolicy Bypass -File &quot;[INSTALLDIR]deploy\windows-server\Install-UIAOService.ps1&quot; -PythonExe &quot;[INSTALLDIR].venv\Scripts\python.exe&quot; -ServicePort [SERVICE_PORT] -IISSitePath &quot;[IIS_SITE_PATH]&quot;"
      Execute="deferred"
      Return="check"
      Impersonate="no" />

    <!-- CA: Stop and remove service on uninstall -->
    <CustomAction
      Id="RemoveService"
      Directory="INSTALLDIR"
      ExeCommand="powershell.exe -NonInteractive -Command &quot;Stop-Service UIAOService -Force -ErrorAction SilentlyContinue; &amp; '[INSTALLDIR].venv\Scripts\python.exe' -m uiao.service remove&quot;"
      Execute="deferred"
      Return="ignore"
      Impersonate="no" />

    <InstallExecuteSequence>
      <Custom Action="InstallDeps"   After="InstallFiles">NOT Installed</Custom>
      <Custom Action="PipInstall"    After="InstallDeps">NOT Installed</Custom>
      <Custom Action="InstallService" After="PipInstall">NOT Installed</Custom>
      <Custom Action="RemoveService" Before="RemoveFiles">REMOVE="ALL"</Custom>
    </InstallExecuteSequence>

  </Package>

  <!-- ---------------------------------------------------------------
       Directory layout
       --------------------------------------------------------------- -->
  <Fragment>
    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLDIR" Name="uiao" />
    </StandardDirectory>
  </Fragment>

  <!-- ---------------------------------------------------------------
       Files — repo contents deployed to INSTALLDIR
       --------------------------------------------------------------- -->
  <Fragment>
    <ComponentGroup Id="UIAOFiles" Directory="INSTALLDIR">
      <Component Id="DeployFiles" Guid="A1B2C3D4-E5F6-7890-ABCD-EF1234567890">
        <!-- Source root — wix build resolves relative to .wxs file location.
             In CI, set UIAO_SRC to the repo root before calling wix build. -->
        <File Id="WebConfigService"
              Source="$(env.UIAO_SRC)\deploy\windows-server\web.config.service-mode"
              Name="web.config.service-mode" />
        <File Id="InstallServiceScript"
              Source="$(env.UIAO_SRC)\deploy\windows-server\Install-UIAOService.ps1"
              Name="Install-UIAOService.ps1" />
        <File Id="InstallServerScript"
              Source="$(env.UIAO_SRC)\scripts\deploy\deploy-scripts.ps1"
              Name="Install-UIAOServer.ps1" />
        <File Id="RunPy"
              Source="$(env.UIAO_SRC)\deploy\windows-server\run.py"
              Name="run.py" />
      </Component>
    </ComponentGroup>
  </Fragment>

  <!-- ---------------------------------------------------------------
       Environment variables — UIAO credentials at machine scope
       --------------------------------------------------------------- -->
  <Fragment>
    <ComponentGroup Id="UIAOEnvVars" Directory="INSTALLDIR">
      <Component Id="EnvVarTenantId"
                 Guid="B2C3D4E5-F6A7-8901-BCDE-F12345678901">
        <util:Environment
          Id="EnvTenantId"
          Name="UIAO_ENTRA_TENANT_ID"
          Value="[TENANT_ID]"
          Action="set"
          System="yes"
          Permanent="no" />
      </Component>
      <Component Id="EnvVarClientId"
                 Guid="C3D4E5F6-A7B8-9012-CDEF-012345678902">
        <util:Environment
          Id="EnvClientId"
          Name="UIAO_ENTRA_CLIENT_ID"
          Value="[CLIENT_ID]"
          Action="set"
          System="yes"
          Permanent="no" />
      </Component>
      <Component Id="EnvVarClientSecret"
                 Guid="D4E5F6A7-B8C9-0123-DEF0-123456789003">
        <util:Environment
          Id="EnvClientSecret"
          Name="UIAO_ENTRA_CLIENT_SECRET"
          Value="[CLIENT_SECRET]"
          Action="set"
          System="yes"
          Permanent="no" />
      </Component>
      <Component Id="EnvVarServicePort"
                 Guid="E5F6A7B8-C9D0-1234-EF01-234567890004">
        <util:Environment
          Id="EnvServicePort"
          Name="UIAO_SERVICE_PORT"
          Value="[SERVICE_PORT]"
          Action="set"
          System="yes"
          Permanent="no" />
      </Component>
      <Component Id="EnvVarWorkspaceRoot"
                 Guid="F6A7B8C9-D0E1-2345-F012-345678900005">
        <util:Environment
          Id="EnvWorkspaceRoot"
          Name="UIAO_WORKSPACE_ROOT"
          Value="[INSTALLDIR]"
          Action="set"
          System="yes"
          Permanent="no" />
      </Component>
    </ComponentGroup>
  </Fragment>

  <!-- ---------------------------------------------------------------
       Windows Service registration
       (Actual install done via custom action; this entry ensures
        MSI tracks the service for clean uninstall.)
       --------------------------------------------------------------- -->
  <Fragment>
    <ComponentGroup Id="UIAOService" Directory="INSTALLDIR">
      <Component Id="UIAOServiceComp"
                 Guid="A7B8C9D0-E1F2-3456-0123-456789000006">
        <ServiceInstall
          Id="UIAOSvcInstall"
          Name="UIAOService"
          DisplayName="UIAO Governance API"
          Description="UIAO organizational governance API. Provides OrgPath web console, AD assessment, and drift reporting."
          Type="ownProcess"
          Start="auto"
          ErrorControl="normal"
          Account="[SERVICE_ACCOUNT]" />
        <ServiceControl
          Id="UIAOSvcCtrl"
          Name="UIAOService"
          Start="install"
          Stop="both"
          Remove="uninstall"
          Wait="yes" />
      </Component>
    </ComponentGroup>
  </Fragment>

  <!-- ---------------------------------------------------------------
       IIS site path placeholder (created by InstallService custom action)
       --------------------------------------------------------------- -->
  <Fragment>
    <ComponentGroup Id="UIAOIISConfig" Directory="INSTALLDIR">
      <Component Id="IISSitePlaceholder"
                 Guid="B8C9D0E1-F2A3-4567-1234-567890000007">
        <!-- Placeholder so MSI tracks the IIS site directory -->
        <CreateFolder Directory="INSTALLDIR" />
      </Component>
    </ComponentGroup>
  </Fragment>

</Wix>
