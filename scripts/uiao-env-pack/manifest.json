{
  "schema_version": 1,
  "pack": {
    "name": "uiao-pwsh-pack",
    "version": "0.1.0",
    "description": "UIAO PowerShell offline pack — pwsh 7 runtime + curated modules + third-party tooling for air-gapped or restricted operator workstations"
  },
  "runtime": {
    "powershell": {
      "version": "7.5.5",
      "url": "https://github.com/PowerShell/PowerShell/releases/download/v7.5.5/PowerShell-7.5.5-win-x64.msi",
      "filename": "PowerShell-7.5.5-win-x64.msi",
      "sha256": null,
      "silent_args": [
        "/quiet",
        "/norestart",
        "ADD_PATH=1",
        "REGISTER_MANIFEST=1",
        "ENABLE_PSREMOTING=0",
        "USE_MU=1"
      ]
    }
  },
  "modules": [
    {
      "name": "powershell-yaml",
      "version": "0.4.12",
      "source": "psgallery"
    },
    {
      "name": "Selenium",
      "version": "3.0.1",
      "source": "psgallery"
    },
    {
      "name": "PSScriptAnalyzer",
      "version": "1.25.0",
      "source": "psgallery"
    },
    {
      "name": "Pester",
      "version": "5.7.1",
      "source": "psgallery"
    },
    {
      "name": "Microsoft.Graph.Authentication",
      "version": "2.37.0",
      "source": "psgallery"
    },
    {
      "name": "Az.Accounts",
      "version": "5.4.0",
      "source": "psgallery"
    }
  ],
  "tools": [
    {
      "name": "git",
      "version": "2.47.0",
      "url": "https://github.com/git-for-windows/git/releases/download/v2.47.0.windows.1/Git-2.47.0-64-bit.exe",
      "filename": "Git-2.47.0-64-bit.exe",
      "sha256": null,
      "silent_args": [
        "/VERYSILENT",
        "/NORESTART",
        "/SUPPRESSMSGBOXES",
        "/NOCANCEL",
        "/SP-"
      ]
    },
    {
      "name": "gh",
      "version": "2.62.0",
      "url": "https://github.com/cli/cli/releases/download/v2.62.0/gh_2.62.0_windows_amd64.msi",
      "filename": "gh_2.62.0_windows_amd64.msi",
      "sha256": null,
      "silent_args": [
        "/quiet",
        "/norestart"
      ]
    }
  ]
}
